<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="member">


    <!-- =====================================
         회원가입
    ====================================== -->

    <insert id="insertMember"
            parameterType="com.app.dto.MemberDTO">


        <!-- 회원번호 먼저 생성 -->

        <selectKey
            keyProperty="memberNo"
            resultType="int"
            order="BEFORE">

            SELECT
                SEQ_MEMBER_NO.NEXTVAL

            FROM DUAL

        </selectKey>


        INSERT INTO MEMBER (

            MEMBER_NO,
            NICKNAME,
            EMAIL,
            MEMBER_PW,
            PROFILE_IMAGE,
            INTRODUCTION

        )

        VALUES (

            #{memberNo},
            #{nickname},
            #{email},
            #{memberPw},
            NULL,
            NULL

        )

    </insert>



    <!-- =====================================
         이메일 중복 검사
    ====================================== -->

    <select id="checkEmail"
            parameterType="string"
            resultType="int">

        SELECT COUNT(*)

        FROM MEMBER

        WHERE EMAIL = #{value}

    </select>



    <!-- =====================================
         닉네임 중복 검사
    ====================================== -->

    <select id="checkNickname"
            parameterType="string"
            resultType="int">

        SELECT COUNT(*)

        FROM MEMBER

        WHERE NICKNAME = #{value}

    </select>



    <!-- =====================================
         관심 키워드 저장
    ====================================== -->

    <insert id="insertInterest"
            parameterType="map">

        INSERT INTO MEMBER_INTEREST (

            MEMBER_NO,
            INTEREST

        )

        VALUES (

            #{memberNo},
            #{interest}

        )

    </insert>



    <!-- =====================================
         회원 정보 조회
    ====================================== -->

    <select id="selectMember"
            parameterType="int"
            resultType="com.app.dto.MemberDTO">

        SELECT

            MEMBER_NO AS memberNo,
            NICKNAME AS nickname,
            EMAIL AS email,
            MEMBER_PW AS memberPw,
            PROFILE_IMAGE AS profileImage,
            INTRODUCTION AS introduction

        FROM MEMBER

        WHERE MEMBER_NO = #{value}

    </select>



    <!-- =====================================
         관심 키워드 조회
    ====================================== -->

    <select id="selectInterests"
            parameterType="int"
            resultType="string">

        SELECT INTEREST

        FROM MEMBER_INTEREST

        WHERE MEMBER_NO = #{value}

        ORDER BY INTEREST

    </select>



    <!-- =====================================
         프로필 수정
    ====================================== -->

    <update id="updateProfile"
            parameterType="com.app.dto.MemberDTO">

        UPDATE MEMBER

        SET

            NICKNAME = #{nickname},
            EMAIL = #{email},
            PROFILE_IMAGE = #{profileImage},
            INTRODUCTION = #{introduction}

        WHERE MEMBER_NO = #{memberNo}

    </update>



    <!-- =====================================
         관심 키워드 삭제
    ====================================== -->

    <delete id="deleteInterests"
            parameterType="int">

        DELETE FROM MEMBER_INTEREST

        WHERE MEMBER_NO = #{value}

    </delete>


	<!-- =====================================
     	이메일 로그인
	====================================== -->

	<select id="login"
        	parameterType="com.app.dto.MemberDTO"
        	resultType="com.app.dto.MemberDTO">

    	SELECT
        	MEMBER_NO AS memberNo,
        	NICKNAME AS nickname,
        	EMAIL AS email,
        	MEMBER_PW AS memberPw,
        	PROFILE_IMAGE AS profileImage,
        	INTRODUCTION AS introduction

    	FROM MEMBER

   		WHERE EMAIL = #{email}
      		AND MEMBER_PW = #{memberPw}

	</select>
</mapper>