<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="comment_mapper">

    <!-- =========================================
         댓글 저장
    ========================================== -->
    <insert id="saveComment"
            parameterType="CommentDTO">

        <selectKey keyProperty="commentId"
                   resultType="long"
                   order="BEFORE">

            SELECT SEQ_COMMENTS.NEXTVAL
            FROM DUAL

        </selectKey>

        INSERT INTO COMMENTS
        VALUES (
            #{commentId},
            #{reviewId},
            #{userId},
            #{content},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )

    </insert>


    <!-- =========================================
         댓글 목록 조회
    ========================================== -->
    <select id="findCommentList"
            resultType="CommentDTO"
            parameterType="long">

        SELECT *
        FROM COMMENTS
        WHERE REVIEW_ID = #{reviewId}
        ORDER BY COMMENT_ID

    </select>


    <!-- =========================================
         댓글 단건 조회
    ========================================== -->
    <select id="findCommentByCommentId"
            resultType="CommentDTO"
            parameterType="long">

        SELECT *
        FROM COMMENTS
        WHERE COMMENT_ID = #{commentId}

    </select>


    <!-- =========================================
         댓글 단건 삭제
    ========================================== -->
    <delete id="removeComment"
            parameterType="long">

        DELETE FROM COMMENTS
        WHERE COMMENT_ID = #{commentId}

    </delete>


    <!-- =========================================
         댓글 수정
    ========================================== -->
    <update id="modifyComment"
            parameterType="CommentDTO">

        UPDATE COMMENTS
        SET
            REVIEW_ID = #{reviewId},
            CONTENT = #{content},
            UPDATED_AT = CURRENT_TIMESTAMP
        WHERE COMMENT_ID = #{commentId}

    </update>


    <!-- =========================================
         MY 페이지 - 데일리 리뷰 삭제용
         해당 리뷰의 댓글 전체 삭제
    ========================================== -->
    <delete id="deleteCommentsByReviewId"
            parameterType="long">

        DELETE FROM COMMENTS
        WHERE REVIEW_ID = #{reviewId}

    </delete>

</mapper>